# AI provider selection: huggingface, ollama, copilot, openai, gemini,
# groq, anthropic, or ast (deterministic generation without a model).
AI_PROVIDER=huggingface

# Shared provider authentication token. Provider-specific keys can also be used.
API_KEY=
COPILOT_TOKEN=
GITHUB_TOKEN=
GH_TOKEN=

# Hugging Face settings
HF_MODEL=Qwen/Qwen3.5-35B-A3B

# GitHub Copilot settings
COPILOT_MODEL=gpt-4o
COPILOT_BASE_URL=https://api.githubcopilot.com

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic settings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Local Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=180

# Server security / behavior
REQUIRE_API_KEY=false
MAX_CONTENT_LENGTH=1048576
CORS_ORIGINS=
